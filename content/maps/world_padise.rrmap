# Padise on about 1 May 1343, after the St George's Night attack and fire.
# Archaeology confirms the early western stone house; the scattered timber service
# buildings are a deliberately conservative gameplay reconstruction, not a room plan.
rrmap 1
map world.padise loc.world_padise 50 30 meadow scope=prototype active=false palette=clean_painted_outdoor seed=1343 cell_size=32
source "scenes/world_travel/world_padise.tscn"
source "scenes/world/padise/padise_monastery.md"
source "docs/reports/padise_monastery_research_p6_009.md"
style stone.early door_side=east ridge_axis=z wall_height=76 wall_color=918d83ff wall_material=limestone roof_color=4b4035ff roof_material=shingle
style timber.monastic door_side=south wall_height=54 wall_color=665849ff wall_material=log roof_color=6c5a3fff roof_material=thatch
style timber.service door_side=south wall_height=46 wall_color=5c4d40ff wall_material=plank roof_color=40372fff roof_material=shingle
style wall.foundation wall_height=18 wall_color=868278ff wall_material=limestone
terrain kloostri_river river_water 0 0 5 24 order=1
terrain river_bank mud 5 0 3 24 order=2
terrain west_fields farm_soil 8 3 9 9 order=3
terrain monastery_close dirt 18 4 25 19 order=4
terrain stone_house_apron stone 19 5 8 18 order=5
terrain burned_guest_house ash 40 6 7 5 order=6
terrain burned_service_yard ash 9 21 9 3 order=7
terrain south_road dirt 0 24 50 4 order=8
terrain east_mud mud 43 12 7 8 order=9
building early_west_stone_house house 20 6 6 16 style=stone.early primitive=stone_hall
building north_masonry_west wall 26 6 6 1 style=wall.foundation primitive=wall
building north_masonry_east wall 35 6 4 1 style=wall.foundation primitive=wall
building timber_oratory house 30 8 8 4 style=timber.monastic primitive=timber_hall
building infirmary_house house 32 14 8 4 style=timber.monastic primitive=timber_hall
building brewery_kitchen house 9 17 8 4 style=timber.service primitive=work_shed
building store_barn house 9 8 7 4 style=timber.monastic primitive=barn
building stable_shed house 41 17 6 4 style=timber.service primitive=work_shed
building burned_guest_sill_south wall 40 10 7 1 style=wall.foundation primitive=palisade
building burned_guest_sill_west wall 40 7 1 3 style=wall.foundation primitive=palisade
prop monastery_well well 28 16 primitive=well
prop scorched_work_cart cart 17 23 primitive=cart
prop herb_beds barrels 41 9 primitive=garden
prop kitchen_stores barrels 14 16 primitive=barrels
prop stable_hay hay_stack 45 15 primitive=hay_stack style_variant=hay_stack.small
decal fire_guest_house scorch 41 7 6 4 radius=2.2 rotation=0.12
decal fire_service_yard scorch 10 21 7 3 radius=2.0 rotation=-0.18
decal smoke_stone_house soot 24 8 2 3 radius=1.4
anchor landmark_early_stone_house 27 14 kind=stone_hall
anchor landmark_timber_oratory 34 13 kind=timber_oratory
anchor landmark_fire_damage 44 11 kind=burned_buildings
anchor landmark_work_yard 15 23 kind=work_yard
anchor landmark_monastery_well 28 16 kind=well
spawn prototype_inspection 4 25
patrol prototype_inspection_route 4,25|14,25|24,24|29,20|34,19|42,22|46,25
transition road_to_reval 46 24 4 3 to=reval_toompea destination_spawn=from_world_padise spawn=from_reval_west spawn_offset_px=-128,0 highlight_area=true transition_visual=ground alignment=travel
transition road_to_parnu 0 24 4 3 to=world_parnu destination_spawn=from_world_padise spawn=from_world_parnu spawn_offset_px=128,0 highlight_area=true transition_visual=ground alignment=travel
