# Unified Central District around the attested 1343 forum. The surviving
# 13th-14th-century street and property skeleton guides direction and adjacency,
# not a measured 1343 cadastre: modern names below are authoring handles only.
# The smaller market opens west to Kullassepa/Dunkri approaches, north through
# Puhavaimu toward Pikk and the harbour ward, and east through a 4-6 m cart throat
# to the Viru/Vene road convergence. The later Vana Turg is not a second square.
# Town Hall closes the forum's south edge; its rear lane and southern approaches
# retain the existing seams to Toompea, the Bishop's Garden, and Knights District.
rrmap 1
map market_civic_quarter loc.lower_town.market_civic_quarter 114 128 dirt scope=prototype active=false palette=clean_painted seed=1343 cell_size=32
source "scenes/reval_center/reval_center.tscn"
source "scenes/revel-map.jpg"
source "scenes/reval_center/market_civic_quarter/market.md"
source "scenes/reval_center/market_civic_quarter/town_hall_square.md"
source "scenes/reval_center/market_civic_quarter/town_hall.md"
source "scenes/reval_center/market_civic_quarter/church_of_the_holy_spirit.md"
source "docs/HISTORICAL_AUDIT.md"
source "history/dossiers/topography/lower-town-street-plan.md"
source "history/dossiers/topography/raekoja-plats-extents-1343.md"
source "history/dossiers/topography/old-market-vanaturg.md"
source "history/dossiers/architecture/burgher-house-plan.md"
# Exceptional civic and church masses remain separate from ordinary house tiers.
# The low 1343 Town Hall predates its 1371-74 full length and 1402-04 upper hall,
# arcade/tower form. Holy Spirit is the earlier chapel-almshouse complex.
style house.town_hall door_side=north ridge_axis=x primitive=town_hall_1343 wall_height=180 wall_color=aaa398ff wall_material=limestone roof_color=873f2dff roof_material=tile
style house.church door_side=south ridge_axis=x primitive=holy_spirit_chapel_1343 wall_height=176 wall_color=9e998cff wall_material=limestone roof_color=42261fff roof_material=tile
style house.hospital door_side=south ridge_axis=x wall_height=112 wall_color=807a70ff wall_material=limestone roof_color=3d3329ff roof_material=shingle
style house.guild door_side=east ridge_axis=x wall_height=136 wall_color=7a7061ff wall_material=limestone roof_color=47291fff roof_material=tile
# R-003 / P0-163 ordinary fabric. North/south fronts use a Z ridge and east/west
# fronts an X ridge so the narrow gable faces the lane. Merchant fronts rise two
# to three storeys; compact craft boda stay one to two storeys.
style house.merchant_stone.south.two door_side=south ridge_axis=z house_tier=merchant_stone wall_height=192 wall_color=756b5cff wall_material=limestone roof_color=4a2a20ff roof_material=tile
style house.merchant_stone.south.three door_side=south ridge_axis=z house_tier=merchant_stone wall_height=224 wall_color=817767ff wall_material=limestone roof_color=573126ff roof_material=tile
style house.merchant_stone.north.two door_side=north ridge_axis=z house_tier=merchant_stone wall_height=192 wall_color=746b5fff wall_material=limestone roof_color=4b2d24ff roof_material=tile
style house.merchant_stone.north.three door_side=north ridge_axis=z house_tier=merchant_stone wall_height=224 wall_color=827969ff wall_material=limestone roof_color=513027ff roof_material=tile
style house.merchant_stone.east.two door_side=east ridge_axis=x house_tier=merchant_stone wall_height=192 wall_color=71695dff wall_material=limestone roof_color=4a2c23ff roof_material=tile
