# Existing reciprocal seams remain stable. The centre does not route directly to
# the exterior Karja Gate: that gate stays on the eastern/southern map boundary.
transition to_town_hall 38 66 4 3 to=town_hall destination_spawn=from_reval_center spawn=to_town_hall spawn_offset_px=0,-96 building_id=town_hall_mass transition_visual=door
transition to_holy_spirit_church 47 13 4 2 to=holy_spirit_church destination_spawn=from_reval_center spawn=to_holy_spirit_church spawn_offset_px=0,96 building_id=church_silhouette transition_visual=door
transition to_reval_east 112 51 2 4 to=reval_east destination_spawn=vana_turg_boundary spawn=from_reval_east spawn_offset_px=-96,0 highlight_area=true transition_visual=ground
transition to_reval_north 34 0 10 2 to=reval_monastery destination_spawn=from_reval_center spawn=to_reval_north spawn_offset_px=0,96 highlight_area=true transition_visual=ground
transition to_reval_toompea 0 49 3 8 to=reval_toompea destination_spawn=from_reval_center spawn=to_reval_toompea spawn_offset_px=96,0 highlight_area=true transition_visual=ground
transition to_archbishops_garden 0 85 3 8 to=reval_archbishops_garden destination_spawn=from_reval_center spawn=to_archbishops_garden spawn_offset_px=96,0 highlight_area=true transition_visual=ground
