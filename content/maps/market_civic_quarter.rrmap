# The forum is a smaller irregular-feeling reserve, mostly trampled earth and
# mud. Stone is localised to thresholds and primary cart routes, never blanket
# tourist-square paving.
terrain forum.ground dirt 24 31 44 35 order=1
terrain forum.wear mud 28 35 36 24 order=2
terrain town_hall.forecourt stone 30 64 30 5 order=3
terrain holy_spirit.close dirt 42 14 35 16 order=4
terrain guild.forecourt dirt 14 27 12 8 order=5
terrain east.road_junction stone 72 47 14 11 order=6
terrain south.yards.west grass 4 105 53 6 order=2
terrain south.yards.east grass 72 105 42 6 order=2
stroke street.pikk_harbour_spine cobblestone 39,0|39,21|48,21|48,31 thickness=4 order=10
stroke street.puhavaimu_route dirt 48,31|48,14 thickness=3 order=11
stroke street.apteegi_route mud 64,31|76,31|76,43|76,52 thickness=3 order=12
stroke street.east_market_throat cobblestone 64,52|76,52|88,52|88,53|112,53 thickness=5 order=13
stroke street.kinga_passage dirt 24,34|20,34|20,32|18,32|18,29 thickness=2 order=14
stroke street.dunkri_approach dirt 24,43|22,43|22,48|11,48|11,53|0,53 thickness=3 order=15
stroke street.kullassepa_approach dirt 24,57|16,57|16,54|10,54|10,53|0,53 thickness=4 order=16
stroke street.raekoja_rear_lane dirt 12,85|24,85|44,85|64,85|76,85 thickness=3 order=17
stroke street.garden_approach mud 0,89|12,89|12,85 thickness=3 order=18
stroke street.kuninga_route mud 74,85|74,89|96,89 thickness=3 order=19
stroke street.karja_south cobblestone 64,85|64,108|64,127 thickness=4 order=20
stroke street.south_service_west mud 4,108|24,108|44,108|57,108 thickness=3 order=21
stroke street.south_service_east mud 71,108|90,108|112,108 thickness=3 order=22
