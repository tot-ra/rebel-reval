# R-623: compact developer-only interior for the accepted early-14th-century Nunnatorn form.
# The south/city-facing side remains open-backed through the authored central gap;
# the three floor bands and stair route are gameplay reconstruction, not an excavated plan.
rrmap 1
map nunnatorn_interior loc.lower_town.nunnatorn_interior 18 18 stone scope=prototype active=false palette=clean_painted seed=1343 cell_size=32
source "docs/reports/nunnatorn_interior_contract.md"
source "docs/reports/nunnatorn_historical_art_review.md"
source "docs/reports/reval_fortifications_1343.md"
source "history/dossiers/topography/walls-gates-towers.md"
style wall.limestone wall_height=176 wall_color=8f8c80ff wall_material=limestone
style wall.partition wall_height=96 wall_color=9a9385ff wall_material=plank
style deck.timber wall_height=72 wall_color=705b49ff wall_material=plank roof_material=shingle
style floor.stone
style light.tallow style_variant=artisan_tallow
terrain ground.stone stone 1 1 16 16 order=1
terrain ground.entry dirt 7 14 5 3 order=2
terrain ground.deck timber_floor 2 2 14 3 order=3
terrain ground.watch timber_floor 2 7 14 4 order=3
terrain ground.roof timber_floor 2 13 14 3 order=3
# Continuous north, west, and east boundaries plus two short south returns keep
# collision sealed without turning the city-facing opening into a later enclosure.
wall wall.north 0 0 17 0 thickness=1 kind=interior_wall style=wall.limestone
wall wall.west 0 0 0 17 thickness=1 kind=interior_wall style=wall.limestone
wall wall.east 17 0 17 17 thickness=1 kind=interior_wall style=wall.limestone
wall wall.south.west 0 17 7 17 thickness=1 kind=interior_wall style=wall.limestone
wall wall.south.east 11 17 17 17 thickness=1 kind=interior_wall style=wall.limestone
# Floor partitions leave one broad aligned opening for the reconstructed stair route.
wall floor.partition.ground 1 6 16 6 thickness=1 openings=7,6,3,1 kind=interior_wall style=wall.partition
wall floor.partition.watch 1 12 16 12 thickness=1 openings=13,12,3,1 kind=interior_wall style=wall.partition
# A restrained upper timber deck and the existing wall-walk semantics provide the
# readable exit without adding a second defensive circuit.
prop nunnatorn_wall_walk_access stairs 14 10 rect=2,4 facing=east primitive=wall_walk_access
prop nunnatorn_wall_walk_platform stairs 16 12 rect=2,5 facing=east primitive=wall_walk_platform
prop nunnatorn_stair_landing stairs 13 11 rect=2,2 facing=north primitive=wall_walk_platform
prop ground_lantern_west candle 3 3 rect=1,1 style_variant=artisan_tallow visual_offset_px=0,-18
prop watch_lantern_east candle 14 8 rect=1,1 style_variant=artisan_tallow visual_offset_px=0,-18
prop roof_lantern_east candle 14 14 rect=1,1 style_variant=artisan_tallow visual_offset_px=0,-18
prop service_chest chest 3 3 rect=2,2 style_variant=chest.burgher
prop watch_table table 10 8 rect=3,1 style_variant=table.trestle_work
prop roof_hoard firewood_stack 4 14 rect=2,1
# These exclusions reserve the hatch and storage footprints while keeping the
# required gameplay anchors and route cells clear.
exclude nunnatorn_storage 3 2 2 2
exclude nunnatorn_roof_hatch 9 13 2 1
spawn spawn.nunnatorn_interior_entry 8 14 rect=2,1
anchor nunnatorn_interior_entry 8 14 rect=2,1 kind=arrival
anchor nunnatorn_floor_ground 5 3 rect=2,2 kind=floor
anchor nunnatorn_floor_watch 5 9 rect=2,2 kind=floor
anchor nunnatorn_floor_roof 5 15 rect=2,1 kind=floor
anchor nunnatorn_wall_walk 15 14 rect=2,2 kind=route
anchor nunnatorn_wall_walk_entry 16 14 rect=1,2 kind=arrival
anchor nunnatorn_boss 11 9 rect=2,2 kind=encounter
anchor nunnatorn_boss_alternate_resolution 12 9 rect=1,1 kind=alternate
anchor nunnatorn_loot 6 3 rect=1,1 kind=loot
anchor nunnatorn_evidence 5 3 rect=1,1 kind=evidence
# R-624 owns the reciprocal manifest destination. The local transition and stable
# spawn id are authored here so the return cell remains deterministic today.
transition nunnatorn_exit 8 16 3 1 to=reval_monastery destination_spawn=monastery_wall_tower_northwest_return spawn=nunnatorn_interior_entry spawn_offset_px=0,-64 transition_visual=door
fade nunnatorn_readability 1 1 16 16
camera 0 0 18 18
