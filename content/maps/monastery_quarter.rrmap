# Monastery District between the civic market and the northern merchant ward.
# St. Olaf's precinct, St. Michael's Cistercian convent, guild frontages, and
# the Pikk/Lai approaches form a broad lower half of the former north quarter.
#
# P4-023e: great_guild_front, blackheads_corner, and brotherhood_wing keep stable
# IDs but render as generic merchant masses. Later Great Guild Hall (1407-10) and
# Brotherhood/Blackheads institutional frontages are excluded (HISTORICAL_AUDIT
# cross-map exclusion 2; monastery landmark row).
#
# Surface policy (docs/HISTORICAL_AUDIT.md monastery_quarter + MAP_AUTHORING):
# Packed-earth base, garden/grass precincts and margins, small stone closes only,
# cobble limited to the Pikk primary spine. Lai, Vene, civic and service lanes use
# mud or packed earth wear instead of treating all named streets as paved.
# Map geometry keeps a broad east-side outer-wall verge: this is the walkable
# extramural road from the Workers' District gate toward the harbour, not a second
# dense city block. The road uses a travel seam so the inner district alignment
# remains anchored by the original Vene transition.
rrmap 1
map monastery_quarter loc.lower_town.monastery_quarter 260 112 dirt scope=prototype active=false palette=clean_painted seed=2721 cell_size=32
# R-454: keep the inner packed-earth precinct and outer travel road on the
# shared zero datum; only the local ditch and its short causeway are recessed.
elevation_area r454.monastery.inner_datum 110 56 110 0.0
elevation_area r454.monastery.outer_road 242 56 56 0.0
elevation_ramp r454.monastery.east_ditch 230 8 230 104 -0.35 -0.35 width=2
elevation_ramp r454.monastery.causeway 230 40 230 52 -0.10 -0.10 width=2
elevation_ramp r454.monastery.north_inner_gate 104 0 236 0 0.0 0.0 width=6
source "scenes/reval_monastery/reval_monastery.tscn"
source "scenes/revel-map.jpg"
source "scenes/reval_north/st_olafs_church.md"
source "docs/HISTORICAL_AUDIT.md"
source "docs/MAP_AUTHORING.md"
style house.merchant.south door_side=south roof_color=3d3329ff roof_material=shingle wall_color=706352ff wall_material=plank wall_height=120
style house.merchant.north door_side=north roof_color=3b332bff roof_material=shingle wall_color=756654ff wall_material=plaster wall_height=120
style house.church door_side=south roof_color=2e241cff roof_material=tile wall_color=807a70ff wall_material=limestone wall_height=192
style house.convent.precinct door_side=east ridge_axis=x primitive=st_michaels_precinct_1343 roof_color=42261fff roof_material=tile wall_color=8c867aff wall_material=limestone wall_height=128
style house.convent.chapel door_side=south ridge_axis=x primitive=st_michaels_chapel_1343 roof_color=42261fff roof_material=tile wall_color=8c867aff wall_material=limestone wall_height=112
style house.convent.service door_side=north ridge_axis=z primitive=st_michaels_service_wing_1343 roof_color=6b5c40ff roof_material=shingle wall_color=6e6458ff wall_material=plaster wall_height=88
style house.convent door_side=east ridge_axis=x roof_color=42261fff roof_material=tile wall_color=8c867aff wall_material=limestone wall_height=128
style house.service door_side=north roof_color=6b5c40ff roof_material=thatch wall_color=5a4f45ff wall_material=log wall_height=88
# R-285 / P4-023b ordinary fabric: R-003 house tiers for the Pikk/Lai strip plots.
# Pikk leans merchant_stone with tile, Lai mixes merchant_timber, and the rear
# service lanes and Vene edge are craft_boda with shingle or thatch. Every style
# keeps gable-to-street massing: door onto the lane, ridge perpendicular to it.
style house.pikk.stone.east door_side=east ridge_axis=x house_tier=merchant_stone roof_color=6b3626ff roof_material=tile wall_color=8a8579ff wall_material=limestone wall_height=136
style house.pikk.stone.west door_side=west ridge_axis=x house_tier=merchant_stone roof_color=6b3626ff roof_material=tile wall_color=857f72ff wall_material=limestone wall_height=136
style house.pikk.timber.east door_side=east ridge_axis=x house_tier=merchant_timber roof_color=4a3a2cff roof_material=shingle wall_color=6d5d4bff wall_material=plank wall_height=120
style house.pikk.timber.west door_side=west ridge_axis=x house_tier=merchant_timber roof_color=4a3a2cff roof_material=shingle wall_color=776552ff wall_material=plaster wall_height=120
style house.lai.timber.west door_side=west ridge_axis=x house_tier=merchant_timber roof_color=46382aff roof_material=shingle wall_color=7a6a58ff wall_material=plaster wall_height=112
style house.lane.timber.south door_side=south ridge_axis=z house_tier=merchant_timber roof_color=4d3b2bff roof_material=shingle wall_color=6a5a48ff wall_material=plank wall_height=112
style house.lane.timber.north door_side=north ridge_axis=z house_tier=merchant_timber roof_color=4d3b2bff roof_material=shingle wall_color=72614dff wall_material=plaster wall_height=112
style house.boda.east door_side=east ridge_axis=x house_tier=craft_boda roof_color=7a6a45ff roof_material=thatch wall_color=5c4f42ff wall_material=log wall_height=88
style house.boda.west door_side=west ridge_axis=x house_tier=craft_boda roof_color=554434ff roof_material=shingle wall_color=5f5244ff wall_material=log wall_height=88
style house.boda.north door_side=north ridge_axis=z house_tier=craft_boda roof_color=7a6a45ff roof_material=thatch wall_color=625445ff wall_material=plank wall_height=88
style house.boda.south door_side=south ridge_axis=z house_tier=craft_boda roof_color=554434ff roof_material=shingle wall_color=5a4d40ff wall_material=log wall_height=88
# R-1036 additions: Lai east-side frontages open west onto Lai, the intramural
# wall lane gets east-facing booths, and rear service ranges (H04-H05 Hinterhaus
# storehouses, stables and brew/bake sheds) stand at the back of the strip plots.
style house.lai.timber.east door_side=east ridge_axis=x house_tier=merchant_timber roof_color=4a392aff roof_material=shingle wall_color=746350ff wall_material=plaster wall_height=112
style house.rear.store.north door_side=north ridge_axis=x roof_color=5e4a34ff roof_material=shingle wall_color=7d776cff wall_material=limestone wall_height=96
style house.rear.store.south door_side=south ridge_axis=x roof_color=5e4a34ff roof_material=shingle wall_color=78736aff wall_material=limestone wall_height=96
style house.rear.shed.east door_side=east ridge_axis=z roof_color=7a6a45ff roof_material=thatch wall_color=5b4e40ff wall_material=log wall_height=80
style house.rear.shed.west door_side=west ridge_axis=z roof_color=6f6040ff roof_material=thatch wall_color=5e5142ff wall_material=log wall_height=80
style house.rear.shed.north door_side=north ridge_axis=x roof_color=554434ff roof_material=shingle wall_color=615343ff wall_material=plank wall_height=80
style house.rear.shed.south door_side=south ridge_axis=x roof_color=6f6040ff roof_material=thatch wall_color=5a4d3fff wall_material=log wall_height=80
style wall.precinct wall_height=112 wall_color=8d897fff
style wall.city wall_height=192 wall_color=949185ff
# round_tower keeps the Tallinn circular drum and conical red-tile roof while
# tower=false marks incomplete 1343 fabric (no ground door / arrow slits).
style wall.tower wall_height=240 wall_color=8c8a80ff round_tower=true
style plant.nettle
style plant.yarrow
style plant.dandelion
style plant.chamomile
style plant.caraway
style plant.st_johns_wort
style plant.mugwort
style plant.plantain
style tree.ash
style tree.elm
style tree.linden
style tree.maple
terrain district.base dirt 0 0 260 112 order=1
terrain convent.garden grass 5 8 58 68 order=2
terrain wall.margin.west grass 3 8 8 96 order=3
terrain wall.margin.east grass 220 8 15 96 order=3
terrain outer_wall.verge grass 228 8 32 96 order=3
terrain outer_wall.road dirt 232 0 20 112 order=8
# Keep the Workers' District visual language at the shared outer road: the
# limestone curtain is followed by a shallow wet ditch and then a packed-earth
# wall road. The travel opening is a dirt causeway through the ditch.
terrain outer_wall.ditch water 228 8 4 104 order=10
terrain outer_wall.causeway dirt 228 40 4 12 order=11
terrain south.seam.grass grass 30 98 110 14 order=3
terrain lai.rear.grass grass 148 60 22 28 order=3
# Medicinal beds and disturbed-ground plants around the convent and wall margins.
terrain convent.nettle grass 45 59 6 4 style=plant.nettle order=3
terrain convent.yarrow grass 52 59 6 4 style=plant.yarrow order=3
terrain convent.chamomile grass 45 64 6 4 style=plant.chamomile order=3
terrain convent.caraway grass 52 64 6 4 style=plant.caraway order=3
terrain wall.dandelion grass 3 80 8 6 style=plant.dandelion order=3
terrain wall.st_johns_wort grass 3 88 8 6 style=plant.st_johns_wort order=3
terrain wall.mugwort grass 220 78 15 6 style=plant.mugwort order=3
terrain wall.plantain grass 220 86 15 6 style=plant.plantain order=3
terrain outer_wall.plantain grass 248 40 10 6 style=plant.plantain order=3
terrain convent.close stone 18 22 24 22 order=4
terrain olaf.close stone 80 56 30 22 order=5
terrain guild.threshold stone 44 28 22 8 order=6
terrain service.yard dirt 146 12 52 50 order=7
terrain workshop.yards mud 118 10 28 24 order=8
terrain east.yards mud 168 40 28 36 order=8
terrain outer_wall.yard mud 200 40 20 36 order=8
terrain pikk.frontage.mud mud 96 20 14 70 order=8
stroke outer_wall_track dirt 232,0|232,28|232,56|232,84|232,110 thickness=5 order=9
stroke pikk_spine cobblestone 101,0|101,24|101,52|101,80|101,110 thickness=4 order=9
stroke lai_lane dirt 135,0|135,28|135,58|135,88|135,110 thickness=3 order=10
stroke vene_lane mud 153,110|153,94|164,94|179,94|179,110 thickness=3 order=11
stroke civic_lane dirt 39,110|39,98|86,98|94,98|101,98 thickness=3 order=12
stroke guild_lane mud 23,54|49,54|49,72|75,72|75,88|101,88 thickness=3 order=13
stroke convent_lane mud 0,34|23,34|23,54|49,54 thickness=3 order=14
# R-285: rear-yard ground behind the new strip plots stays trodden mud rather
# than an unowned dirt field; the service lane links the north-east plots.
terrain pikk.west.rear_yards mud 70 3 18 26 order=8
terrain lai.north.rear_yards mud 150 14 48 2 order=8
terrain vene.block.yards mud 156 105 21 5 order=8
stroke rear_service_lane mud 150,4|208,4|208,38 thickness=3 order=14
# R-1036: a cross lane between Pikk and Lai (the patrol already walks it), the
# yard lane that serves the new plots east of Lai, and the intramural lane inside
# the east curtain. Trodden earth, like the other secondary lanes.
stroke pikk_lai_cross_lane mud 103,55|118,55|134,55 thickness=3 order=14
stroke east_yard_lane mud 137,57|176,57|214,57 thickness=3 order=14
stroke intramural_wall_lane mud 216,38|216,66|216,96 thickness=3 order=14
# Tallinn's medieval wall circuit continues along the exposed west and east
# sides. The open north/south district seams remain streets rather than walls.
building monastery_city_wall_west_north wall 0 0 3 20 style=wall.city
building monastery_wall_tower_northwest wall 0 0 8 8 style=wall.tower tower=true door_side=east
# R-624: the inward-facing tower door is a reciprocal developer transition into
# the dedicated Nunnatorn interior; the return spawn is kept on the same door.
transition nunnatorn_enter 6 3 2 1 to=nunnatorn_interior destination_spawn=nunnatorn_interior_entry spawn=monastery_wall_tower_northwest_return spawn_offset_px=96,0 building_id=monastery_wall_tower_northwest transition_visual=door
# The western gate cut is retained for inter-district travel, but later paired
# gate-tower silhouettes are deliberately suppressed in the 1343 snapshot.
building monastery_west_gate_north_tower wall 0 20 8 8 style=wall.tower tower=false
building monastery_west_gate_south_tower wall 0 40 8 8 style=wall.tower tower=false
building monastery_west_gate_north_jamb wall 0 27 8 2 style=wall.city tower=false
building monastery_west_gate_south_jamb wall 0 39 8 2 style=wall.city tower=false
building monastery_city_wall_west_south wall 0 48 3 64 style=wall.city
building monastery_wall_tower_west_mid wall 0 72 8 8 style=wall.tower tower=true door_side=east
# P4-027c: reciprocal developer-only entry into the dedicated Golden Leg tower.
transition kuldjala_enter 6 75 2 1 to=kuldjala_interior destination_spawn=kuldjala_interior_entry spawn=monastery_wall_tower_west_mid_return spawn_offset_px=96,0 building_id=monastery_wall_tower_west_mid transition_visual=door
