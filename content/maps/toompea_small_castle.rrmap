# Danish crown Small Castle interior prototype for April-May 1343.
# Room sizes are production labels, not measured archaeology; the cross-wall and
# forecourt/residence split follow the accepted Toompea interior dossier.
rrmap 1
map toompea_small_castle loc.toompea.small_castle 32 24 stone scope=prototype active=false palette=clean_painted seed=1343 cell_size=32
source "history/dossiers/architecture/toompea-small-castle-interior.md"
source "history/dossiers/architecture/toompea-castle-and-upper-town.md"
source "docs/HISTORICAL_AUDIT.md"
style wall.limestone wall_height=176 wall_color=8f8c80ff wall_material=limestone
style wall.partition wall_height=112 wall_color=766d60ff wall_material=plank
style house.residence door_side=south ridge_axis=x wall_height=128 wall_color=8a8278ff wall_material=limestone roof_color=3a2218ff roof_material=shingle
style house.service door_side=north ridge_axis=x wall_height=88 wall_color=705f4fff wall_material=plank roof_color=4c382bff roof_material=shingle
terrain castle_floor stone 0 0 32 24 order=1
terrain forecourt dirt 2 14 28 8 order=2
stroke forecourt_lane dirt 3,20|16,20|16,14|16,10|16,4 thickness=2 order=3
stroke residence_lane dirt 16,10|18,10|18,14 thickness=2 order=4
# The complete perimeter is a restrained interior shell. The cross-wall leaves a
# single controlled gate opening between the southern forecourt and north enclosure.
wall outer_north 0 0 31 0 thickness=1 kind=interior_wall style=wall.limestone
wall outer_west 0 0 0 23 thickness=1 kind=interior_wall style=wall.limestone
wall outer_east 31 0 31 23 thickness=1 kind=interior_wall style=wall.limestone
wall outer_south 0 23 31 23 thickness=1 kind=interior_wall style=wall.limestone
wall cross_wall_west 1 12 14 12 thickness=1 kind=interior_wall style=wall.partition
wall cross_wall_east 18 12 30 12 thickness=1 kind=interior_wall style=wall.partition
# These masses define labelled rooms without importing a later cloistered ward.
building viceroy_audience house 4 3 10 6 style=house.residence
building viceroy_private house 20 3 8 6 style=house.residence
building service_cellar house 4 9 7 3 style=house.service
building castle_chapel house 20 9 8 4 style=house.residence
building bailey_workshop house 4 16 8 4 style=house.service
building bailey_stables house 20 16 8 4 style=house.service
landmark gate_tower gate_arch 14 10 4 4 wall_color=8f8c80ff top_px=176 passage_axis=y door_material=wood gate_variant=oak
landmark west_window interior_window 1 5 2 3 wall_color=8f8c80ff grille_variant=bricked_void interior_side=east
prop forecourt_cart farm_cart 10 19 rect=2,2
prop audience_table table 15 7 rect=2,1
prop chapel_banner banner 24 14 rect=2,2 faction=danish_crown
prop service_chest chest 12 10 rect=2,2
spawn small_castle_entry 16 20 rect=2,1
anchor sc-forecourt 4 20 rect=2,2 kind=zone
anchor sc-gate-tower 16 13 rect=2,2 kind=zone
anchor sc-viceroy-audience 15 8 rect=2,2 kind=zone
anchor sc-viceroy-private 18 8 rect=2,2 kind=zone
anchor sc-castle-chapel 18 14 rect=2,2 kind=zone
anchor sc-service-cellar 12 10 rect=2,2 kind=zone
anchor ob-courtyard 16 20 rect=2,2 kind=zone
anchor ob-east-gate 29 20 rect=2,2 kind=zone
# Developer return to the Danish hill host. This remains data-only until the
# dedicated interior scene activation task supplies a separate packed scene.
transition to_toompea_quarter 14 21 4 2 to=reval_toompea destination_spawn=from_small_castle spawn=from_small_castle spawn_offset_px=0,-128 transition_visual=ground
fade castle_interior_readability 1 1 30 22
camera 0 0 32 24
