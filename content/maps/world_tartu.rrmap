# Debug travel greybox for Dorpat Castle: reachable from the global map in every act.
rrmap 1
map world.tartu loc.world_tartu 54 30 mud scope=prototype active=false palette=clean_painted_outdoor seed=1363 cell_size=32
source "scenes/world_travel/world_tartu.tscn"
source "docs/LOCATIONS/tartu_dorpat.md"
source "docs/LOCATIONS/README.md"
terrain town_road dirt 3 12 48 6 order=1
terrain market_common mud 14 18 26 5 order=2
terrain yards straw 6 5 12 5 order=3
building west_house house 6 6 10 5 primitive=work_shed wall_height=40
building east_house house 36 6 10 5 primitive=work_shed wall_height=40
building hall house 21 6 12 5 primitive=stone_hall wall_height=68
building warehouse house 20 19 8 4 primitive=storehouse wall_height=54
prop market_well well 27 15 primitive=well
prop supply_cart cart 33 22 primitive=cart
anchor landmark_market_square 27 15 kind=camp
anchor landmark_town_hall 27 11 kind=stone_keep
anchor landmark_warehouse_row 24 24 kind=camp
spawn prototype_inspection 4 26
patrol prototype_inspection_route 4,26|15,26|27,26|39,26|50,26
transition road_to_poltsamaa 0 24 4 4 to=world_poltsamaa destination_spawn=from_world_tartu spawn=from_world_poltsamaa spawn_offset_px=128,0 highlight_area=true transition_visual=ground alignment=travel
transition road_to_viljandi 50 24 4 4 to=world_viljandi destination_spawn=from_world_tartu spawn=from_world_viljandi spawn_offset_px=-128,0 highlight_area=true transition_visual=ground alignment=travel
transition road_to_frontier_ugandi 23 26 4 4 to=world_frontier_ugandi destination_spawn=from_world_tartu spawn=from_world_frontier_ugandi spawn_offset_px=0,-128 highlight_area=true transition_visual=ground alignment=travel
transition road_to_reval 23 0 4 4 to=reval_city destination_spawn=gate.harju.outside spawn=from_reval_south spawn_offset_px=0,128 highlight_area=true transition_visual=ground alignment=travel
