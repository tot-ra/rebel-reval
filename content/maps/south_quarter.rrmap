# Knights District between Archbishop's Garden, Rataskaev, Niguliste, and Karja Gate.
# Compact Knights District: trimmed western ward under Toompea while
# keeping garden, central, and workers district seams on the north edge.
# streets and buildings retain their scale in the eastern half, while a continuous
# stepped curtain and dated tower-position masses now seal the full southern circuit.
rrmap 1
map south_quarter loc.lower_town.south_quarter 336 96 grass scope=prototype active=false palette=clean_painted seed=1375 cell_size=32 elevation=0.0
# R-454f: keep the ordinary Lower Town plane flat, let the King-to-Karja
# approach fall only slightly, and keep the uncertain Karja glacis as a shallow
# low mud band. The garden opening remains on the shared lower-town datum.
elevation_area r454.south.lower_town_datum 240 48 96 0.0
elevation_ramp r454.south.king_to_karja 213 0 240 71 0.0 -0.10 width=3
elevation_area r454.south.karja_glacis 243 90 24 -0.25
# R-676: keep the dry Karja opening on the authored -0.10 datum while the
# surrounding glacis remains the lower, uncertain wet-edge reconstruction.
elevation_area r454.south.karja_causeway 247 90 7 -0.10
elevation_area r454.south.garden_seam 29 0 10 0.0
source "scenes/reval_south/reval_south.tscn"
source "scenes/revel-map.jpg"
source "scenes/reval_south/rataskaev_well.md"
source "scenes/reval_south/knights_quarters.md"
source "scenes/reval_center/market_civic_quarter/market.md"
source "docs/HISTORICAL_AUDIT.md"
style house.merchant.south door_side=south ridge_axis=x wall_height=112 wall_color=706352ff wall_material=plank roof_color=383029ff roof_material=shingle
style house.merchant.north door_side=north ridge_axis=x wall_height=120 wall_color=756654ff wall_material=plaster roof_color=3d3329ff roof_material=shingle
style house.knights door_side=south ridge_axis=x wall_height=128 wall_color=7a7061ff wall_material=limestone roof_color=47291fff roof_material=tile faction=livonian_order
style house.artisan door_side=north ridge_axis=x wall_height=96 wall_color=63594aff wall_material=log roof_color=6b5c40ff roof_material=thatch
style house.gatehouse door_side=north ridge_axis=x wall_height=136 wall_color=6e6a62ff wall_material=limestone roof_color=2a241cff roof_material=tile
style wall.city wall_height=192 wall_color=949185ff
# round_tower keeps the Tallinn circular drum and conical red-tile roof while
# tower=false marks incomplete 1343 fabric (no ground door / arrow slits).
style wall.tower wall_height=240 wall_color=8c8a80ff round_tower=true
# R-282 / R-677 ordinary fabric: R-003 house tiers for the strip-plot rows.
# Front houses put the gable to the street (ridge perpendicular to it);
# stone fronts stay below the knights' hall and gatehouse heights so no
# ordinary house reads as a landmark. Rear ranges, stables, sheds and
# extramural barns are low log, plank or daub service fabric without a tier.
style house.south.stone.north door_side=north ridge_axis=z house_tier=merchant_stone roof_color=5e3325ff roof_material=tile wall_color=857f73ff wall_material=limestone wall_height=124
style house.south.timber.north door_side=north ridge_axis=z house_tier=merchant_timber roof_color=4a3a2cff roof_material=shingle wall_color=6d5d4bff wall_material=plank wall_height=112
style house.south.boda.north door_side=north ridge_axis=z house_tier=craft_boda roof_color=76663fff roof_material=thatch wall_color=5c4f42ff wall_material=log wall_height=88
