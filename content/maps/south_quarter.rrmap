style house.south.stable door_side=south ridge_axis=x roof_color=7a6a45ff roof_material=thatch wall_color=5a4d40ff wall_material=timber wall_height=72
style house.south.shed door_side=south roof_color=6b5c40ff roof_material=thatch wall_color=5a4f45ff wall_material=plank wall_height=64
style house.south.shed.log door_side=north roof_color=5e5036ff roof_material=shingle wall_color=5c5042ff wall_material=log wall_height=64
style house.south.barn door_side=south ridge_axis=x roof_color=7a6a45ff roof_material=thatch wall_color=5c5042ff wall_material=log wall_height=88
# Grass and packed earth fill ordinary plots and yards. Cobble is reserved for
# the Rataskaev/King approach and the Karja/Viru gate axis; minor lanes use mud
# or dirt, with compact stone only at institutional thresholds and wall walks.
terrain_rects quarter.base dirt 144,0,192,25|144,9,190,25|147,34,187,25|150,59,181,15|156,74,166,8|170,82,140,6|198,88,96,8 order=1
terrain rataskaev_close grass 158 9 31 19 order=2
terrain niguliste_close grass 161 37 31 19 order=3
terrain dunkri_yard dirt 202 9 45 22 order=4
terrain karja_glacis mud 219 84 48 12 order=5
# R-454f: shallow wet wall-edge ditches stay inside the map edge and outside
# the Karja gate throat. The dry overlay is a level causeway, not a new wall or
# barbican, and keeps the existing southern transition corridor walkable.
terrain south_wall.ditch.west water 156 90 72 6 order=15
terrain south_wall.ditch.east water 267 90 69 6 order=15
terrain east_wall.ditch water 331 9 5 57 order=15
terrain karja.causeway dirt 240 84 14 12 order=16
# R-676: named surface bands keep the compressed reconstruction legible in the
# editor and audit without turning the western connector into a second frontage.
terrain south.western_connector dirt 4 0 140 82 order=2
terrain_rects south.western_pasture grass 4,60,140,22 order=3
terrain south.garden_seam grass 20 0 28 12 order=3
terrain south.eastern_ward dirt 257 0 74 82 order=6
terrain_rects south.service_plots mud 192,18,18,12|245,40,14,8|284,42,14,8|288,60,18,8 order=6
# Stone/paving bands are concentrated on primary approaches, institutional closes,
# and selected property thresholds; they are not a district-wide limestone fill.
terrain_rects south.stone_closes stone 158,9,31,19|161,37,31,19|188,0,20,16|226,0,48,16|282,0,22,16|188,37,25,15|225,37,25,15|264,16,32,18|294,16,24,18|225,56,36,17|286,56,34,17|304,12,27,28|304,56,27,24|226,16,31,20|188,16,25,20|188,50,25,20|225,64,36,16|264,64,40,16 order=7
terrain_rects south.wall_margins mud 156,84,72,6|267,84,69,6|325,9,6,57 order=14
terrain old_hill_foot dirt 144 12 17 75 order=6
terrain north_rataskaev_yard dirt 151 0 31 12 order=7
terrain north_civic_threshold dirt 226 0 48 16 order=7
terrain east_viru_threshold sand 302 0 31 12 order=7
terrain_rects wall_walk_stone stone 156,74,24,6|180,78,28,6|208,82,24,8|262,82,32,8|294,78,16,8|310,72,12,8 order=7
# R-282 / R-677: pebble-and-rubble verges beside the Karja gate road (H10
# early rubble/pebble road, B/U). The new plots roof over part of the
# institutional stone closes, so this keeps the stone share in its band.
terrain_rects south.karja_approach_verges stone 235,58,4,26|243,58,4,26 order=7
stroke rataskaev_street cobblestone 144,6|175,6|202,6|226,6 thickness=3 order=8
stroke dunkri_lane mud 213,0|213,3|213,21|213,40 thickness=2 order=9
stroke king_street cobblestone 213,0|213,8|233,8|257,8 thickness=3 order=10
stroke niguliste_lane dirt 144,49|171,49|192,49|192,43|213,43 thickness=3 order=11
stroke karja_lane cobblestone 219,40|219,56|240,56|261,56 thickness=3 order=12
stroke viru_internal_lane cobblestone 261,56|288,56|328,56|328,40|318,40|318,0 thickness=3 order=13
stroke karja_gate_road cobblestone 240,56|240,71|240,94 thickness=3 order=14
# R-282 / R-677: two irregular dirt lanes and a mud cross-lane give the
# western connector its own looser plot rows under Toompea. Neutral
# production names (design composite, confidence D), not attested streets.
stroke south.western_upper_lane dirt 34,6|90,6|90,5|120,5|120,6|143,6 thickness=3 order=8
stroke south.western_lower_lane dirt 16,41|70,41|70,43|112,43|112,45|136,45|136,49|144,49 thickness=3 order=8
stroke south.western_cross_lane mud 88,7|88,24|86,24|86,43 thickness=2 order=8
