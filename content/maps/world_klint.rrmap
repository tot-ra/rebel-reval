# Debug travel greybox for Baltic Klint Coast: reachable from the global map in every act.
rrmap 1
map world.klint loc.world_klint 54 30 mud scope=prototype active=false palette=clean_painted_outdoor seed=1371 cell_size=32
source "scenes/world_travel/world_klint.tscn"
source "docs/LOCATIONS/baltic_klint_coast.md"
source "docs/LOCATIONS/README.md"
terrain sea_edge mud 0 0 54 5 order=1
terrain cliff_ledge stone 0 5 54 6 order=2
terrain coast_road dirt 0 13 54 4 order=3
terrain upland meadow 0 17 54 13 order=4
building lime_kiln house 34 19 8 5 primitive=storehouse wall_height=60
building quarry_shed house 10 19 8 4 primitive=work_shed wall_height=40
prop signal_fire barrels 27 14 primitive=signal_fire
prop quarry_cart cart 22 22 primitive=cart
anchor landmark_cliff_edge 27 7 kind=fieldworks
anchor landmark_lime_kiln 38 25 kind=camp
anchor landmark_quarry 14 25 kind=camp
spawn prototype_inspection 4 26
patrol prototype_inspection_route 4,26|15,26|27,26|39,26|50,26
transition road_to_haapsalu 0 24 4 4 to=world_haapsalu destination_spawn=from_world_klint spawn=from_world_haapsalu spawn_offset_px=128,0 highlight_area=true transition_visual=ground alignment=travel
transition road_to_reval 50 24 4 4 to=reval_city destination_spawn=road.toompea_west spawn=from_reval_west spawn_offset_px=-128,0 highlight_area=true transition_visual=ground alignment=travel
