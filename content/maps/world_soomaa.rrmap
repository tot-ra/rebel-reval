# Debug travel greybox for Soomaa Flood Refuge: reachable from the global map in every act.
rrmap 1
map world.soomaa loc.world_soomaa 54 30 mud scope=prototype active=false palette=clean_painted_outdoor seed=1372 cell_size=32
source "scenes/world_travel/world_soomaa.tscn"
source "docs/LOCATIONS/soomaa_flood_refuge.md"
source "docs/LOCATIONS/README.md"
terrain flood_water bog 0 0 54 12 order=1
terrain shallows mud 0 12 54 5 order=2
terrain causeway dirt 2 17 50 4 order=3
terrain dry_bank meadow 0 21 54 9 order=4
building pile_hut house 34 22 8 4 primitive=work_shed wall_height=36
building boat_shed house 10 22 8 4 primitive=storehouse wall_height=40
prop signal_fire barrels 27 19 primitive=signal_fire
prop field_standard banner 40 18 primitive=standard
anchor landmark_causeway 27 19 kind=bog_causeway
anchor landmark_pile_hut 38 28 kind=camp
anchor landmark_boat_shed 14 28 kind=camp
spawn prototype_inspection 4 26
patrol prototype_inspection_route 4,26|15,26|27,26|39,26|50,26
transition road_to_viljandi 0 24 4 4 to=world_viljandi destination_spawn=from_world_soomaa spawn=from_world_viljandi spawn_offset_px=128,0 highlight_area=true transition_visual=ground alignment=travel
transition road_to_karksi 50 24 4 4 to=world_karksi destination_spawn=from_world_soomaa spawn=from_world_karksi spawn_offset_px=-128,0 highlight_area=true transition_visual=ground alignment=travel
transition road_to_lihula 23 26 4 4 to=world_lihula destination_spawn=from_world_soomaa spawn=from_world_lihula spawn_offset_px=0,-128 highlight_area=true transition_visual=ground alignment=travel
transition road_to_reval 23 0 4 4 to=reval_city destination_spawn=gate.harju.outside spawn=from_reval_south spawn_offset_px=0,128 highlight_area=true transition_visual=ground alignment=travel
