# Compact Lower Town smithy interior. Warm limewash, local limestone, and exposed timber
# follow the material hierarchy of a fourteenth-century Reval craft dwelling; the forge
# half is deliberately smoke-darkened while the living half keeps cleaner lime plaster.
rrmap 1
map kalev_smithy loc.kalev_smithy 26 14 stone scope=production active=true palette=clean_painted seed=42042 cell_size=32
source "scenes/reval_east/forge/forge.tscn"
source "docs/SCENES/the-makers-mark.md"
source "content/locations/loc.kalev_smithy.json"
style wall.living wall_height=120 wall_color=cdb892ff wall_material=plaster
style wall.forge wall_height=120 wall_color=9b8768ff wall_material=smoked_plaster
style wall.partition wall_height=120 wall_color=b59d78ff wall_material=plaster
terrain floor.forge stone 15 1 10 12 order=1
terrain floor.hearth ash 17 1 8 5 order=2
terrain floor.living timber_floor 1 1 13 12 order=3
wall wall.north_living 0 0 14 0 thickness=1 openings=5,0,1,1 kind=interior_wall style=wall.living
wall wall.north_forge 15 0 25 0 thickness=1 openings=20,0,1,1 kind=interior_wall style=wall.forge
wall wall.south_living 0 13 11 13 thickness=1 kind=interior_wall style=wall.living
wall wall.south_forge 14 13 25 13 thickness=1 kind=interior_wall style=wall.forge
wall wall.west 0 1 0 12 thickness=1 openings=0,6,1,2 kind=interior_wall style=wall.living
wall wall.east 25 1 25 12 thickness=1 openings=25,6,1,2 kind=interior_wall style=wall.forge
wall wall.divider 14 1 14 12 thickness=1 openings=14,7,1,2 kind=interior_wall style=wall.partition
prop forge_anvil anvil 18 5 rect=3,2
# Long riveted tongs stand at the anvil apron so the smith can hold hot stock.
prop forge_tongs blacksmith_tongs 17 6 rect=1,1 facing=west
prop forge_furnace furnace 19 1 rect=3,3
# Bellows west of the forge mouth; nozzle aims at the tuyere on the left cheek.
prop forge_bellows bellows 16 2 rect=2,2
prop forge_ledger ledger 4 3 rect=2,2
# Coded Black Cloak swallow cloth in the living bay - not municipal heraldry.
prop cloak_banner banner 5 2 rect=2,2 faction=black_cloaks
prop table_candle candle 8 11 rect=1,1 visual_offset_px=0,-18 style_variant=artisan_tallow
prop quench quench_bucket 16 5 rect=2,2
prop bed bed 3 9 rect=4,2
prop chest chest 2 7 rect=2,2 style_variant=chest.burgher
prop food_table table 6 10 rect=4,3
prop work_chair chair 10 10 rect=2,2
prop tool_shelf shelf 22 2 rect=2,2
prop coal_store charcoal_pile 23 4
prop iron_scrap_store iron_scrap_pile 21 5
# Living-bay domestic dressing (P2-057): hearth, wash, provisions, table settings, door tools.
prop domestic_hearth hearth 1 1 rect=3,3 style_variant=hearth.lit
prop hearth_kindling_store household_clutter 3 3 style_variant=household.kindling_bundle
prop provision_peas household_clutter 4 1 style_variant=provision.dried_peas_bin
prop provision_onions household_clutter 4 2 style_variant=provision.onion_braid
prop provision_salt household_clutter 1 4 style_variant=provision.salt_crock
prop provision_bread household_clutter 5 3 style_variant=provision.rye_bread_loaf
prop wash_basin wash_tub 11 1 rect=1,1
prop water_bucket household_clutter 10 1 style_variant=household.water_bucket
prop wash_cloth kitchenware 12 1 style_variant=kitchenware.basin_cloth
prop chest_provisions household_clutter 2 6 style_variant=household.group.closed
prop table_settings kitchenware 7 10 style_variant=kitchenware.group.eating
prop table_prep kitchenware 5 11 style_variant=kitchenware.group.prep
prop table_cleanup kitchenware 9 11 style_variant=kitchenware.group.cleanup
prop bed_linen household_clutter 4 9 style_variant=household.linen_folded
prop apron_hook household_clutter 1 8 style_variant=household.apron
prop ash_scoop household_clutter 11 12 style_variant=household.ash_scoop
prop broom household_clutter 10 12 style_variant=household.broom
landmark window.north_living interior_window 5 0 1 1 passage_axis=z
landmark window.north_forge interior_window 20 0 1 1 passage_axis=z
landmark window.west interior_window 0 6 1 2 passage_axis=x
landmark window.east interior_window 25 6 1 2 passage_axis=x
# Spawn in the working bay with clearance for the default third-person boom
# (yaw 45, southeast offset). Northwest view frames quench, anvil, and furnace.
spawn spawn.main 19 7 rect=2,2
anchor anvil 18 5 rect=3,2
anchor ledger 4 3 rect=2,2
anchor bed_alcove 3 9 rect=4,2
transition door_courtyard 12 13 2 1 to=reval_east destination_spawn=forge spawn=door_courtyard spawn_offset_px=0,-64
transition smithy_start_spawn 19 7 2 2 spawn=smithy_start
decal decal.soot_furnace_pad soot 19 1 3 3 radius=1.8
decal decal.soot_anvil_apron soot 18 5 3 2 radius=1.4
decal decal.grime_quench grime 16 5 2 2 radius=1.1
decal decal.wet_wash_corner wet_threshold 11 1 1 1 radius=1.0
decal decal.mud_courtyard_door mud 12 13 2 1 radius=1.3
decal decal.wet_courtyard_door wet_threshold 12 12 2 1 radius=1.0
decal decal.grime_bay_divider grime 14 7 1 2 radius=1.0
exclude blocked.fore 10 1 8 1
fade fade.fore 10 1 8 2
camera 0 0 26 14
