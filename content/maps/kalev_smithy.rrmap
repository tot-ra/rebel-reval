# Compact Lower Town smithy interior. Warm limewash, local limestone, and exposed timber
# follow the material hierarchy of a fourteenth-century Reval craft dwelling; the forge
# half is deliberately smoke-darkened while the living half keeps cleaner lime plaster.
rrmap 1
map kalev_smithy loc.kalev_smithy 26 14 stone scope=production active=true palette=clean_painted seed=42042 cell_size=32
source "scenes/reval_east/forge/forge.tscn"
source "docs/SCENES/the-makers-mark.md"
source "content/locations/loc.kalev_smithy.json"
style wall.living wall_height=120 wall_color=cdb892ff wall_material=plaster
style wall.forge wall_height=120 wall_color=9b8768ff wall_material=smoked_plaster
style wall.partition wall_height=120 wall_color=b59d78ff wall_material=plaster
terrain floor.forge stone 15 1 10 12 order=1
terrain floor.hearth ash 17 1 8 5 order=2
terrain floor.living timber_floor 1 1 13 12 order=3
wall wall.north_living 0 0 14 0 thickness=1 openings=5,0,1,1 kind=interior_wall style=wall.living
wall wall.north_forge 15 0 25 0 thickness=1 openings=20,0,1,1 kind=interior_wall style=wall.forge
wall wall.south_living 0 13 11 13 thickness=1 kind=interior_wall style=wall.living
wall wall.south_forge 14 13 25 13 thickness=1 kind=interior_wall style=wall.forge
wall wall.west 0 1 0 12 thickness=1 openings=0,6,1,2 kind=interior_wall style=wall.living
wall wall.east 25 1 25 12 thickness=1 openings=25,6,1,2 kind=interior_wall style=wall.forge
wall wall.divider 14 1 14 12 thickness=1 openings=14,7,1,2 kind=interior_wall style=wall.partition
prop forge_anvil anvil 18 5 rect=3,2
# Long riveted tongs, forging hammer, and punch stay at the anvil apron so the
# smith can reach each tool without turning the independently placeable props
# into loose floor clutter.
prop forge_tongs blacksmith_tongs 17 6 rect=1,1 facing=west
prop forge_hammer blacksmith_hammer 18 5 rect=1,1 facing=west visual_offset_px=18,-18
prop forge_punch blacksmith_punch 19 5 rect=1,1 facing=west visual_offset_px=-10,-19
prop forge_furnace furnace 19 1 rect=3,3
# Bellows west of the forge mouth; nozzle aims at the tuyere on the left cheek.
prop forge_bellows bellows 16 2 rect=2,2
prop forge_ledger ledger 4 3 rect=2,2
# Coded Black Cloak swallow cloth hung on the living-bay west wall between the
# window head and the ledger nook - not municipal heraldry, and not a free mast.
# The banner kit faces +X, so facing=east keeps the embroidered plate readable
# from the room while the top rod stays flush to the plaster.
prop cloak_banner banner 1 4 rect=1,1 faction=black_cloaks facing=east visual_offset_px=-16,0
prop quench quench_bucket 16 5 rect=2,2
prop bed bed 3 9 rect=4,2
# Storage chest turned along the west wall under the window, lid reachable from
# the room rather than stranded a metre out on open floor.
prop chest chest 1 7 rect=1,2 style_variant=chest.burgher facing=east
prop tool_shelf shelf 22 2 rect=2,2
prop coal_store charcoal_pile 23 4
prop iron_scrap_store iron_scrap_pile 21 5
# Living-bay kitchen range along the north wall (P2-057, re-dressed).
# WHY: the fixtures were authored on footprints far larger than the shipped
# models, so a 1.0 m hearth sat mid-corner facing its own back wall and the
# 0.1-0.6 m kitchenware read as litter dropped on bare boards. The range now
# runs hearth -> fuel -> prep bench -> cupboard against the plaster, every
# fixture is turned to open into the room, and each small item is offset onto
# the surface it belongs to instead of the floor. One cell is one metre, so
# footprints are sized to the GLB, not to zone bands.
prop domestic_hearth hearth 2 1 rect=2,1 style_variant=hearth.lit facing=south
prop hearth_kindling_store household_clutter 4 1 style_variant=household.kindling_bundle
prop kitchen_work_table table 5 1 rect=3,1 style_variant=table.trestle_work
prop kitchen_stool chair 5 2 rect=1,1 facing=north
prop kitchen_dresser shelf 8 1 rect=2,1 style_variant=shelf.burgher_cupboard facing=south
# Cooking stores live on the trestle top (y 0.822) and cupboard head (y 1.52).
# X offsets space each item along the 1.58 m board so nothing overhangs an edge.
prop provision_peas household_clutter 5 1 style_variant=provision.dried_peas_bin visual_offset_px=12.2,-26.3
prop table_prep kitchenware 6 1 style_variant=kitchenware.group.prep visual_offset_px=-5.8,-26.3
prop provision_bread household_clutter 6 1 style_variant=provision.rye_bread_loaf visual_offset_px=9,-26.3
prop provision_salt household_clutter 7 1 style_variant=provision.salt_crock visual_offset_px=-16,-26.3
prop provision_onions household_clutter 9 1 style_variant=provision.onion_braid visual_offset_px=-16,-48.6
# Hand-wash stand at the courtyard end of the range; bucket and cloth ride its
# lower shelf (y 0.32) so the wash corner is furniture, not a puddle on boards.
prop wash_basin wash_tub 10 1 rect=1,1 style_variant=wash.stand_basin facing=south
prop water_bucket household_clutter 10 1 style_variant=household.water_bucket visual_offset_px=-6.4,-10.2
prop wash_cloth kitchenware 10 1 style_variant=kitchenware.basin_cloth visual_offset_px=4.2,-10.2
prop apron_hook household_clutter 1 2 style_variant=household.apron facing=east visual_offset_px=-15,-38
prop chest_provisions household_clutter 1 9 style_variant=household.group.closed
# Eating board: the 2.3 m long-board variant, because settings, cleared bowls,
# and the tallow candle together need 1.5 m of top and the household table only
# offers 1.5 m in total - on the shorter base the candle overhung the edge.
# Stools sit on the north side so the meal-beat approach cells south of the
# board, (7,11) and (8,11), stay clear of props.
prop food_table table 7 10 rect=3,1 style_variant=table.long_board
prop table_stool_west chair 7 9 rect=1,1 facing=south
prop table_stool_east chair 9 9 rect=1,1 facing=south
prop work_chair chair 11 10 rect=1,1 facing=west
prop table_settings kitchenware 7 10 style_variant=kitchenware.group.eating visual_offset_px=11.2,-25.3
prop table_cleanup kitchenware 8 10 style_variant=kitchenware.group.cleanup visual_offset_px=3.2,-25.3
prop table_candle candle 9 10 rect=1,1 style_variant=artisan_tallow visual_offset_px=-8,-25.3
prop bed_linen household_clutter 4 9 style_variant=household.linen_folded visual_offset_px=0,-25.3
prop ash_scoop household_clutter 11 12 style_variant=household.ash_scoop
prop broom household_clutter 10 12 style_variant=household.broom
landmark window.north_living interior_window 5 0 1 1 passage_axis=z
landmark window.north_forge interior_window 20 0 1 1 passage_axis=z
landmark window.west interior_window 0 6 1 2 passage_axis=x
landmark window.east interior_window 25 6 1 2 passage_axis=x
# New-game / wake spawn: stand at the bed foot matching ap.sleep.wake (4,10).
# smithy_start must share this cell - Start flow uses DoorNavigator spawn
# smithy_start, not definition.player_spawn, so leaving it at the anvil kept
# Kalev waking in the work bay.
spawn spawn.main 4 10
anchor anvil 18 5 rect=3,2
anchor ledger 4 3 rect=2,2
anchor bed_alcove 3 9 rect=4,2
transition door_courtyard 12 13 2 1 to=reval_east destination_spawn=forge spawn=door_courtyard spawn_offset_px=0,-64
transition smithy_start_spawn 4 10 1 1 spawn=smithy_start
decal decal.soot_furnace_pad soot 19 1 3 3 radius=1.8
decal decal.soot_anvil_apron soot 18 5 3 2 radius=1.4
decal decal.grime_quench grime 16 5 2 2 radius=1.1
decal decal.wet_wash_corner wet_threshold 11 1 1 1 radius=1.0
decal decal.mud_courtyard_door mud 12 13 2 1 radius=1.3
decal decal.wet_courtyard_door wet_threshold 12 12 2 1 radius=1.0
decal decal.grime_bay_divider grime 14 7 1 2 radius=1.0
exclude blocked.fore 10 1 8 1
fade fade.fore 10 1 8 2
camera 0 0 26 14
