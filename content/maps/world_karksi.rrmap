# Debug travel greybox for Karksi-Nuia: reachable from the global map in every act.
rrmap 1
map world.karksi loc.world_karksi 54 30 mud scope=prototype active=false palette=clean_painted_outdoor seed=1367 cell_size=32
source "scenes/world_travel/world_karksi.tscn"
source "docs/LOCATIONS/viljandi_fellin.md"
source "docs/LOCATIONS/README.md"
terrain moat mud 8 4 38 20 order=1
terrain castle_yard castle_paving 11 6 32 16 order=2
terrain approach_road dirt 0 24 54 4 order=3
building curtain_north wall 11 6 32 1 primitive=wall wall_height=56
building curtain_west wall 11 6 1 17 primitive=wall wall_height=56
building curtain_east wall 42 6 1 17 primitive=wall wall_height=56
building gatehouse_west house 22 22 2 3 primitive=gatehouse wall_height=76
building gatehouse_east house 28 22 2 3 primitive=gatehouse wall_height=76
building keep house 22 9 10 8 primitive=stone_keep wall_height=92
building storehouse house 34 15 6 4 primitive=storehouse wall_height=54
prop yard_well well 17 17 primitive=well
prop supply_cart cart 15 20 primitive=cart
anchor landmark_gatehouse 26 25 kind=gatehouse
anchor landmark_central_keep 27 18 kind=stone_keep
anchor landmark_yard_well 17 18 kind=camp
spawn prototype_inspection 4 26
patrol prototype_inspection_route 4,26|15,26|27,26|39,26|50,26
transition road_to_viljandi 0 24 4 4 to=world_viljandi destination_spawn=from_world_karksi spawn=from_world_viljandi spawn_offset_px=128,0 highlight_area=true transition_visual=ground alignment=travel
transition road_to_helme 50 24 4 4 to=world_helme destination_spawn=from_world_karksi spawn=from_world_helme spawn_offset_px=-128,0 highlight_area=true transition_visual=ground alignment=travel
transition road_to_soomaa 23 26 4 4 to=world_soomaa destination_spawn=from_world_karksi spawn=from_world_soomaa spawn_offset_px=0,-128 highlight_area=true transition_visual=ground alignment=travel
transition road_to_reval 23 0 4 4 to=reval_city destination_spawn=gate.harju.outside spawn=from_reval_south spawn_offset_px=0,128 highlight_area=true transition_visual=ground alignment=travel
