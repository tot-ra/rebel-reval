# Interior modeled on the Tallinn Town Hall (Raekoda) room sequence after
# W. Neumann & E. Nottbeck (Reval 1904): west Burghers' Hall, central
# Councillors' Hall, and east kämmerei/treasury/kitchen strip. Scope remains
# pre-tower 1343; the post-1404 partitions are a deliberate legibility choice
# matching the exterior arcade decision in HISTORICAL_AUDIT.md.
rrmap 1
map town_hall loc.lower_town.town_hall 40 24 timber_floor scope=prototype active=false palette=clean_painted seed=1343 cell_size=32
source "scenes/reval_center/town_hall/town_hall.tscn"
source "docs/HISTORICAL_AUDIT.md"
source "scenes/reval_center/market_civic_quarter/town_hall.md"
style wall.civic wall_height=136 wall_color=b8ad98ff wall_material=plaster
style wall.smoked wall_height=136 wall_color=8c806fff wall_material=smoked_plaster
style wall.partition wall_height=112 wall_color=9a9488ff wall_material=timber
style block.dais wall_height=32 wall_color=8f887cff wall_material=limestone
style block.pillar wall_height=112 wall_color=8a8276ff wall_material=limestone
# Limestone threshold, council dais, pillars, and kitchen hearth; timber boards
# and limewashed plaster elsewhere, as on the surviving Raekoda mass.
terrain entry_threshold stone 17 20 6 3 order=1
terrain council_dais_stone stone 19 3 10 3 order=2
terrain scribe_bay plaster 31 2 8 8 order=3
terrain hearth_apron stone 31 16 7 5 order=4
wall wall.north 0 0 39 0 thickness=1 openings=7,0,2,1|19,0,2,1|31,0,2,1 kind=interior_wall style=wall.civic
wall wall.south 0 23 39 23 thickness=1 openings=17,23,6,1 kind=interior_wall style=wall.civic
wall wall.west 0 1 0 22 thickness=1 openings=0,10,1,3 kind=interior_wall style=wall.civic
wall wall.east_north 39 1 39 10 thickness=1 openings=39,5,1,2 kind=interior_wall style=wall.smoked
wall wall.east_south 39 11 39 22 thickness=1 kind=interior_wall style=wall.civic
# Burghers' Hall | Councillors' Hall partition (west 43%, center 32% of length).
wall wall.burghers_council 17 1 17 22 thickness=1 openings=17,9,1,4|17,16,1,3 kind=interior_wall style=wall.partition
# Councillors' Hall | east kämmerei/treasury/kitchen strip.
wall wall.council_east 30 1 30 22 thickness=1 openings=30,8,1,3|30,15,1,3 kind=interior_wall style=wall.partition
# East ancillary rooms: scribe north, treasury mid, kitchen south.
wall wall.east_scribe 31 10 38 10 thickness=1 openings=34,10,2,1 kind=interior_wall style=wall.partition
building council_dais_block interior_block 19 3 10 2 style=block.dais
building burghers_pillar_north interior_block 8 7 2 2 style=block.pillar
building burghers_pillar_south interior_block 8 15 2 2 style=block.pillar
prop burgomaster_chair chair 24 5 rect=2,2
prop alderman_chair_west chair 20 8 rect=2,2
prop alderman_chair_east chair 27 8 rect=2,2
prop petition_table table 9 13 rect=8,3
prop petition_ledger ledger 12 13 rect=2,2
prop scribe_table table 33 5 rect=5,3
prop scribe_chair chair 35 8 rect=2,2
prop archive_shelf_north shelf 32 3 rect=2,3
prop archive_shelf_west shelf 32 7 rect=2,3
prop charter_chest chest 36 4 rect=2,2
prop treasury_chest chest 33 12 rect=2,2
prop civic_hearth_block hearth 33 17 rect=4,3
prop service_table table 35 12 rect=4,3
prop waiting_bench_west table 4 18 rect=6,1
prop waiting_bench_east table 24 18 rect=6,1
prop entry_candle_west candle 16 20 rect=1,1 visual_offset_px=0,-18
prop entry_candle_east candle 23 20 rect=1,1 visual_offset_px=0,-18
landmark window.north_west interior_window 7 0 2 1 passage_axis=z
landmark window.north_center interior_window 19 0 2 1 passage_axis=z
landmark window.north_east interior_window 31 0 2 1 passage_axis=z
landmark window.west interior_window 0 10 1 3 passage_axis=x
landmark window.east interior_window 39 5 1 2 passage_axis=x
spawn spawn.inspection 19 18 rect=2,2
anchor inspection_spawn 19 18 rect=2,2
anchor public_entry 19 20 rect=2,2
anchor petition_desk 12 14 rect=4,2
anchor council_dais 24 5 rect=6,2
anchor scribe_archive 34 6 rect=4,4
anchor civic_hearth 34 17 rect=4,3
transition to_reval_center 18 22 4 2 to=reval_center destination_spawn=to_town_hall spawn=from_reval_center spawn_offset_px=0,-96 highlight_area=true transition_visual=ground alignment=travel
fade roof_fade 10 2 20 5
camera 0 0 40 24
