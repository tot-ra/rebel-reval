# Debug travel greybox for Otepää - Vastseliina Frontier: reachable from the global map in every act.
rrmap 1
map world.frontier_ugandi loc.world_frontier_ugandi 54 30 mud scope=prototype active=false palette=clean_painted_outdoor seed=1373 cell_size=32
source "scenes/world_travel/world_frontier_ugandi.tscn"
source "docs/LOCATIONS/otepaa_vastseliina_frontier.md"
source "docs/LOCATIONS/README.md"
terrain forest_floor meadow 0 0 54 30 order=1
terrain track dirt 0 13 54 4 order=2
terrain clearing ash 18 18 18 8 order=3
building watch_hut house 36 6 8 4 primitive=work_shed wall_height=40
building store_hut house 10 6 8 4 primitive=storehouse wall_height=44
prop signal_fire barrels 27 20 primitive=signal_fire
prop broken_cart cart 20 10 primitive=cart
anchor landmark_crossing 27 14 kind=camp
anchor landmark_clearing_fire 27 21 kind=camp
anchor landmark_watch_hut 40 12 kind=camp
spawn prototype_inspection 4 26
patrol prototype_inspection_route 4,26|15,26|27,26|39,26|50,26
transition road_to_tartu 0 24 4 4 to=world_tartu destination_spawn=from_world_frontier_ugandi spawn=from_world_tartu spawn_offset_px=128,0 highlight_area=true transition_visual=ground alignment=travel
transition road_to_helme 50 24 4 4 to=world_helme destination_spawn=from_world_frontier_ugandi spawn=from_world_helme spawn_offset_px=-128,0 highlight_area=true transition_visual=ground alignment=travel
transition road_to_reval 23 26 4 4 to=reval_city destination_spawn=gate.harju.outside spawn=from_reval_south spawn_offset_px=0,-128 highlight_area=true transition_visual=ground alignment=travel
