{
  "type": "dialogue",
  "id": "dialogue.city.spirit_duel",
  "title": "Spirit duel with anyone in the city",
  "confidence": "invented",
  "canon_status": "draft",
  "approval": {
    "status": "draft",
    "notes": "R-1889 (ADR 0047, ADR 0033): generic spirit duel opened on any resident or named NPC from spirit sight; topic 'daily_burden' (work, bread, family, sin, fear). No flags: a duel with a stranger has no lasting consequence yet."
  },
  "deterministic_offline": {
