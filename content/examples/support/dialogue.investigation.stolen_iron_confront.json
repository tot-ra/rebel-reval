  "nodes": [
    {
      "id": "confront_resolved",
      "speaker_id": "char.mart",
      "text": "Dry harbor road, cooper gauge marks, and his sawdust on the crate rim. Only the apprentice had motive and access.",
      "choices": [
        {
          "id": "press_accusation",
          "text": "Bring him to the yard.",
          "target_node_id": "confront_close"
        }
      ]
    },
    {
      "id": "confront_narrow",
      "speaker_id": "char.mart",
      "text": "Courier and cooper are ruled out. That leaves the apprentice, but we still need his bench trail in hand.",
      "choices": [
        {
          "id": "keep_watch",
          "text": "Keep watching the lane.",
          "target_node_id": "confront_close"
        }
      ]
    },
    {
      "id": "confront_partial_harbor",
      "speaker_id": "char.mart",
      "text": "No wet cart ruts from the harbor, so the courier story dies here. The apprentice and cooper remain.",
      "choices": [
        {
          "id": "note_courier_cleared",
          "text": "Courier is off the list.",
          "target_node_id": "confront_close"
        }
      ]
    },
    {
      "id": "confront_partial_sawdust",
      "speaker_id": "char.mart",
      "text": "Oak sawdust from his bench, but without the road and hasp reads we cannot corner him yet.",
      "choices": [
        {
          "id": "gather_more",
          "text": "We need more proof.",
          "target_node_id": "confront_close"
        }
      ]
    },
    {
      "id": "confront_blind",
      "speaker_id": "char.mart",
      "text": "Three names and no proof. Accuse the wrong one and the watch will pin it on us.",
      "choices": [
        {
          "id": "walk_away",
          "text": "Keep digging.",
          "target_node_id": "confront_close"
        }
      ]
    },
    {
      "id": "confront_close",
      "speaker_id": "char.kalev",
      "text": "Then we move carefully. Iron does not forgive a sloppy accusation."
    }
  ],
