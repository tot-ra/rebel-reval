  "nodes": [
    {
      "id": "kalev_heard_struck",
      "speaker_id": "char.kalev",
      "text": "The matron says you laid hands on the porter. I have a temper too, boy. It has cost me more than it ever won me.",
      "next_node_id": "kalev_looks"
    },
    {
      "id": "kalev_heard_broke",
      "speaker_id": "char.kalev",
      "text": "Hanß is sitting on the cold-store step, white as flour, and he will not say what you said to him. Remember that words cut too.",
      "next_node_id": "kalev_looks"
    },
    {
      "id": "kalev_heard_punished",
      "speaker_id": "char.kalev",
      "text": "Show me the hand. The rod, for a loaf. Keep it out of the fire until it heals.",
      "next_node_id": "kalev_looks"
    },
    {
      "id": "kalev_looks",
      "speaker_id": "char.kalev",
      "text": "My apprentice has gone, and the forge will not stoke itself. Can you carry iron, boy?",
      "next_node_id": "kalev_offer",
      "choices": [
        {
          "id": "yes",
          "text": "Yes.",
          "target_node_id": "kalev_offer"
        },
        {
          "id": "stare",
          "text": "[Say nothing, and watch him]",
          "target_node_id": "kalev_offer"
        }
      ]
    },
    {
      "id": "kalev_offer",
      "speaker_id": "char.kalev",
      "text": "A bed by the hearth and bread twice a day. Work from before light. Come.",
      "effects": [
        {
          "op": "set_flag",
          "key": "flag.prologue.apprenticed",
          "value": true
        }
      ]
    }
  ],
