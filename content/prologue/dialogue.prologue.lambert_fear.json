      "lines": {
        "fear": [
          {
            "text": "The dark you ran from came in with you. It sits on the wound.",
            "relevance": [
              "night",
              "wound"
            ]
          },
          {
            "text": "You still hear him calling. You will hear him every night.",
            "relevance": [
              "comrade",
              "night"
            ]
          }
        ],
        "shame": [
          {
            "text": "A watchman with his back to the fight. That is what you see when you close your eyes.",
            "relevance": [
              "flight"
            ]
          },
          {
            "text": "Tönnies called your name, Lambert.",
            "relevance": [
              "comrade",
              "flight"
            ]
          }
        ],
        "duty": [
          {
            "text": "A watchman who lives keeps the next watch. Keep this one: lie still.",
            "relevance": [
              "wound",
              "home"
            ]
          },
          {
            "text": "You owe Tönnies a prayer, not a grave beside him.",
            "relevance": [
              "comrade"
            ]
          }
        ],
        "love": [
          {
            "text": "Someone at home keeps the fire for you tonight. Stay for them.",
            "relevance": [
              "home"
            ]
          },
          {
            "text": "I have your hand. Feel it. You are not alone in the dark.",
            "relevance": [
              "night",
              "wound"
            ]
          }
        ],
        "faith": [
          {
            "text": "Tönnies is with God. Pray for him, and do not follow him tonight.",
            "relevance": [
              "comrade"
            ]
          },
          {
            "text": "There is a candle by your head. The Holy Spirit keeps this house.",
            "relevance": [
              "night",
              "home"
            ]
          }
        ]
      }
    }
  },
  "nodes": [
