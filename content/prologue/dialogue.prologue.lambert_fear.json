        "kind": "pressure",
        "element": "fear",
        "stakes": [
          "obligation"
        ],
        "spirit_image_id": "cold_hearth"
      },
      "choices": [
        {
          "id": "love_hold",
          "text": "It will hurt, and then it will be over. I will hold you the whole time.",
