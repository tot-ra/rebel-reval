  "nodes": [
    {
      "id": "accuse",
      "speaker_id": "char.almshouse_porter",
      "text": "A loaf is missing from the cold store. You were seen near it, boy!",
      "move": {
        "kind": "attack",
        "element": "shame",
        "stakes": [
          "respect"
        ],
        "spirit_image_id": "rusted_key"
      },
      "choices": [
        {
          "id": "fire_hands",
          "text": "Look at your own hands, Hanß. I saw where the barley went.",
          "target_node_id": "porter_presses",
          "move": {
            "kind": "attack",
            "element": "shame",
            "stakes": [
              "secret"
            ]
          },
          "spell_id": "spell.pagan.fireball"
        },
        {
          "id": "ward_rod",
          "text": "Your rod does not frighten me.",
          "target_node_id": "porter_presses",
          "move": {
            "kind": "defense",
            "element": "fear",
            "stakes": [
              "respect"
            ]
          },
          "spell_id": "spell.pagan.iron_skin"
        },
        {
          "id": "still_hunger",
          "text": "Stand still. The little one is crying for bread.",
          "target_node_id": "porter_presses",
          "move": {
            "kind": "appeal",
            "element": "love",
            "stakes": [
              "obligation"
            ]
          },
          "spell_id": "spell.pagan.earth_tremor"
        },
        {
          "id": "shove",
          "text": "[Shove him away]",
          "target_node_id": "resolved_struck",
          "move": {
            "kind": "attack",
            "element": "fear",
            "stakes": [
              "respect"
            ]
          },
          "effects": [
            {
              "op": "set_flag",
              "key": "flag.prologue.struck_porter",
              "value": true
            }
          ]
        }
      ]
    },
    {
      "id": "porter_presses",
      "speaker_id": "char.almshouse_porter",
      "text": "Liars get the rod. Say it again, and look at me!",
      "move": {
        "kind": "pressure",
        "element": "duty",
        "stakes": [
          "obligation"
        ],
        "spirit_image_id": "rod"
      },
      "choices": [
        {
          "id": "fire_lock",
          "text": "Every night you lock the cold store. Who are you afraid of?",
          "target_node_id": "porter_cornered",
          "move": {
            "kind": "attack",
            "element": "fear",
            "stakes": [
              "secret"
            ]
          },
          "spell_id": "spell.pagan.fireball"
        },
        {
          "id": "still_duty",
          "text": "Matron said no child goes to bed hungry. Hear it.",
          "target_node_id": "porter_cornered",
          "move": {
            "kind": "appeal",
            "element": "duty",
            "stakes": [
              "obligation"
            ]
          },
          "spell_id": "spell.pagan.earth_tremor"
        },
        {
          "id": "ward_hold",
          "text": "Strike, then. I will not move.",
          "target_node_id": "porter_cornered",
          "move": {
            "kind": "defense",
            "element": "fear",
            "stakes": [
              "respect"
            ]
          },
          "spell_id": "spell.pagan.iron_skin"
        },
        {
          "id": "say_nothing",
          "text": "[Say nothing]",
          "target_node_id": "resolved_punished",
          "move": {
            "kind": "evade",
            "element": "shame",
            "stakes": [
              "respect"
            ]
          }
        }
      ]
    },
    {
      "id": "porter_cornered",
      "speaker_id": "char.almshouse_porter",
      "text": "Enough! I will beat the truth out of you!",
      "move": {
        "kind": "attack",
        "element": "fear",
        "stakes": [
          "respect"
        ],
        "spirit_image_id": "rod"
      },
      "choices": [
        {
          "id": "fire_secret",
          "text": "The key is rusted because you feed no one but yourself.",
          "target_node_id": "resolved_broken",
          "move": {
            "kind": "attack",
            "element": "fear",
            "stakes": [
              "secret"
            ]
          },
          "spell_id": "spell.pagan.fireball"
        },
        {
          "id": "still_mercy",
          "text": "Take the heel of it to her yourself, Hanß. Stand still, and give.",
          "target_node_id": "resolved_spared",
          "move": {
            "kind": "appeal",
            "element": "love",
            "stakes": [
              "obligation"
            ]
          },
          "spell_id": "spell.pagan.earth_tremor"
        },
        {
          "id": "ward_shame",
          "text": "Strike me, and the whole house will see who you are.",
          "target_node_id": "resolved_spared",
          "move": {
            "kind": "defense",
            "element": "shame",
            "stakes": [
              "respect"
            ]
          },
          "spell_id": "spell.pagan.iron_skin"
        }
      ]
    },
    {
      "id": "resolved_spared",
      "speaker_id": "char.almshouse_porter",
      "text": "Hm. Take the heel of it to the little one. And you did not hear this from me."
    },
    {
      "id": "resolved_broken",
      "speaker_id": "char.almshouse_porter",
      "text": "Stop it! Take the loaf. Take the key. God help me, only stop looking at me like that.",
      "effects": [
        {
          "op": "set_flag",
          "key": "flag.prologue.broke_porter",
          "value": true
        }
      ]
    },
    {
      "id": "resolved_punished",
      "speaker_id": "char.almshouse_porter",
      "text": "The rod, then. Hold out your hand.",
      "effects": [
        {
          "op": "set_flag",
          "key": "flag.prologue.punished_by_porter",
          "value": true
        }
      ]
    },
    {
      "id": "resolved_struck",
      "speaker_id": "char.almshouse_porter",
      "text": "You little... Matron! MATRON!"
    }
  ],
  "source_notes": [
