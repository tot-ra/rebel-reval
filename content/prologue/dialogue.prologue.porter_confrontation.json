      ],
      "lines": {
        "fear": [
          {
            "text": "You lock the cold store at night because you fear the hungry, not the thieves.",
            "relevance": [
              "key",
              "hunger"
            ]
          },
          {
            "text": "One day they will take that key from you, Hanß. You know it.",
            "relevance": [
              "key",
              "place"
            ]
          }
        ],
        "shame": [
          {
            "text": "The key is rusted and the bread is gone. Whose hand turned it?",
            "relevance": [
              "key",
              "bread"
            ]
          },
          {
            "text": "You weigh the orphans' loaves and keep the heels.",
            "relevance": [
              "bread",
              "orphan"
            ]
          },
          {
            "text": "Look the little ones in the eye, Hanß.",
            "relevance": [
              "orphan"
            ]
          }
        ],
        "duty": [
          {
            "text": "The bread of this house is owed to its children.",
            "relevance": [
              "bread",
              "orphan"
            ]
          },
          {
            "text": "You keep the key for the house, not for your belly.",
            "relevance": [
              "key",
              "place"
            ]
          }
        ],
        "love": [
          {
            "text": "She is four winters old and hungry. Give her the heel.",
            "relevance": [
              "bread",
              "orphan",
              "hunger"
            ]
          },
          {
            "text": "I have no mother and no father. This house is the only place I have.",
            "relevance": [
              "orphan",
              "place"
            ]
          }
        ],
        "faith": [
          {
            "text": "The Holy Spirit fed this house before you ever held its key.",
            "relevance": [
              "key",
              "place"
            ]
          },
          {
            "text": "Bread kept from orphans is bread kept from God.",
            "relevance": [
              "bread",
              "orphan"
            ]
          }
        ],
        "coin": [
          {
            "text": "The council pays for every loaf. Who sold the missing ones?",
            "relevance": [
              "bread"
            ]
          },
          {
            "text": "A rusted key and a full purse, Hanß. I can count.",
            "relevance": [
              "key"
            ]
          }
        ]
      }
    }
  },
  "nodes": [
    {
      "id": "accuse",
      "speaker_id": "char.almshouse_porter",
      "text": "A loaf is missing from the cold store. You were seen near it, boy!",
      "move": {
        "kind": "attack",
        "element": "shame",
        "stakes": [
          "respect"
        ],
        "spirit_image_id": "rusted_key"
      },
      "choices": [
        {
          "id": "fire_hands",
          "text": "Look at your own hands, Hanß. I saw where the barley went.",
          "target_node_id": "porter_presses",
          "move": {
            "kind": "attack",
            "element": "shame",
            "stakes": [
              "secret"
            ],
            "topic_tags": [
              "bread"
            ]
          },
          "spell_id": "spell.pagan.fireball"
        },
        {
          "id": "ward_rod",
          "text": "Your rod does not frighten me.",
          "target_node_id": "porter_presses",
          "move": {
            "kind": "defense",
            "element": "fear",
            "stakes": [
              "respect"
            ]
          },
          "spell_id": "spell.pagan.iron_skin"
        },
        {
          "id": "still_hunger",
          "text": "Stand still. The little one is crying for bread.",
          "target_node_id": "porter_presses",
          "move": {
            "kind": "appeal",
            "element": "love",
            "stakes": [
              "obligation"
            ],
            "topic_tags": [
              "bread",
              "orphan",
              "hunger"
            ]
          },
          "spell_id": "spell.pagan.earth_tremor"
        },
        {
          "id": "shove",
          "text": "[Shove him away]",
          "target_node_id": "resolved_struck",
          "move": {
            "kind": "attack",
            "element": "fear",
            "stakes": [
              "respect"
            ]
          },
          "effects": [
            {
              "op": "set_flag",
