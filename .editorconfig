root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

# GDScript uses tabs with size 4
[*.gd]
indent_style = tab
indent_size = 4
max_line_length = 100

# Godot scene and resource files use tabs
[*.{tscn,tres}]
indent_style = tab

# Markdown uses trailing spaces for line breaks, keep them
[*.md]
trim_trailing_whitespace = false
