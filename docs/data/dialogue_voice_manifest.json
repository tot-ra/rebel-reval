      "entry_id": "normal",
      "source": "content/examples/valid/bark.district.north_merchant.normal.json",
      "source_pointer": "$.entries[0]",
      "speaker_id": "char.henning",
      "locale": "en",
      "text_key": "",
      "text": "Pikk stays busy, but the guild seals stay unbroken.",
