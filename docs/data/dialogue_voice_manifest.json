      "source": "content/examples/valid/bark.district.north_merchant.relaxed.json",
      "source_pointer": "$.entries[0]",
      "speaker_id": "char.henning",
      "locale": "en",
      "text_key": "",
      "text": "Guild tally-men gossip and let the lane breathe.",
      "text_sha256": "8550ecbeff4288d38252b61214b4409f8cc6821a6dba0ce56efda2a213a23f86",
      "provider": "elevenlabs",
      "model_id": "eleven_multilingual_v2",
      "voice_id": null,
