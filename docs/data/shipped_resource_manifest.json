{
  "version": 1,
  "task_id": "P0-202",
  "release_presets": ["rr", "act1"],
  "diagnostic_preset": "rr-diagnostic",
  "export_filter": "all_resources",
  "release_exclude_filter": "tests/*, tools/*, agents/*, generated/*, addons/*, img/*, history/*, story/*, archive/*, quarantine/*, docs/reports/*, docs/adr/*, docs/CHARACTERS/*, docs/SYSTEMS/*, docs/lore/*, scenes/debug/*, scenes/tests/*, character/inspiration/*, build/*, .github/*, bin/*",
  "diagnostic_exclude_filter": "agents/*, generated/*, addons/*, img/*, history/*, story/*, archive/*, quarantine/*, docs/reports/*, docs/adr/*, docs/CHARACTERS/*, docs/SYSTEMS/*, docs/lore/*, scenes/debug/*, character/inspiration/*, build/*, .github/*, bin/*",
  "include_filter": "LICENSE, CREDITS.md, docs/THIRD_PARTY_NOTICES.md, assets/fonts/NotoSans-OFL-1.1.txt, assets/characters/shared/KAYKIT_CC0_LICENSE.txt, scripts/map/view3d/third_party/d3_celestial_BSD_3_CLAUSE.txt",
  "must_not_exclude": [
    "characters/",
    "character/",
    "music/",
    "sounds/",
    "content/",
    "assets/",
    "scripts/",
    "scenes/menu/",
    "scenes/reval_east/",
    "docs/data/"
  ],
  "required_paths": [
    "res://LICENSE",
    "res://CREDITS.md",
    "res://docs/THIRD_PARTY_NOTICES.md",
    "res://assets/fonts/NotoSans-OFL-1.1.txt",
    "res://assets/characters/shared/KAYKIT_CC0_LICENSE.txt",
    "res://scripts/map/view3d/third_party/d3_celestial_BSD_3_CLAUSE.txt",
    "res://content/transitions/active_destinations.json",
    "res://assets/characters/cat/cat_rig.tscn",
    "res://assets/storybook/forge_cat/forge_cat.glb",
    "res://characters/rebels/martin.png",
    "res://character/image.png",
    "res://music/menu/Menu.mp3",
    "res://music/forge/Fireside Tale.mp3",
    "res://scripts/global/music_director.gd",
    "res://scripts/dialogue/dialogue_portrait_resolver.gd",
    "res://scripts/global/door_navigator.gd",
    "res://scenes/menu/main_menu.tscn",
    "res://scenes/reval_east/forge/forge.tscn",
    "res://scenes/reval_east/reval_east.tscn"
  ],
  "required_prefixes": [
    "res://scripts/",
    "res://scenes/menu/",
    "res://scenes/reval_east/",
    "res://assets/",
    "res://music/",
    "res://sounds/",
    "res://content/demo/",
    "res://content/packages/",
    "res://content/examples/",
    "res://content/transitions/",
    "res://characters/",
    "res://docs/data/",
    "res://audio/"
  ],
  "forbidden_prefixes": [
    "res://tests/",
    "res://tools/",
    "res://agents/",
    "res://generated/",
    "res://addons/",
    "res://img/",
    "res://history/",
    "res://story/",
    "res://archive/",
    "res://quarantine/",
    "res://docs/reports/",
    "res://docs/adr/",
    "res://docs/CHARACTERS/",
    "res://docs/SYSTEMS/",
    "res://docs/lore/",
    "res://scenes/debug/",
    "res://scenes/tests/",
    "res://character/inspiration/",
    "res://build/",
    "res://.github/",
    "res://bin/"
  ],
  "forbidden_imported_substrings": [
    "cat_hunyuan3d_local.glb",
    "forge_cat_hunyuan3d_v1.glb",
    "forge_cat_reference_source.blend"
  ],
  "diagnostic_allowed_prefixes": [
    "res://tests/",
    "res://tools/"
  ],
  "notes": {
    "music": "Keep the full music/ library in Git. Optional build-time playlist selection is a later P0-180 discussion, not this export cut.",
    "generated": "Forge-cat runtime is assets/storybook/forge_cat/forge_cat.glb via cat_rig.tscn. Hunyuan rebuild outputs stay under generated/ only.",
    "characters": "characters/ and character/ hold runtime dialogue portraits; do not exclude them.",
    "diagnostic": "rr-diagnostic keeps tests/ and tools/ for packaged acceptance that must run inside a pack. Release presets exclude those trees."
  }
}
