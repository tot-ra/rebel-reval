{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "magic.schema.json",
  "title": "Reval Rebel authored dual-school magic content",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "id",
    "name",
    "confidence",
    "canon_status",
    "approval",
    "resolution",
    "runtime_combination_allowed",
    "source_notes"
  ],
  "properties": {
    "type": {
      "enum": [
        "spell",
        "rite",
        "magic_grant"
      ]
    },
    "id": {
      "$ref": "common.schema.json#/$defs/content_id"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "school": {
      "enum": [
        "school.pagan",
        "school.divine"
      ]
    },
    "sequence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "string",
        "pattern": "^element\\.[a-z][a-z0-9_]*$"
      }
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^element\\.[a-z][a-z0-9_]*$"
      }
    },
    "resolution": {
      "const": "authored_lookup"
    },
    "fixed_liturgy": {
      "const": true
    },
    "runtime_combination_allowed": {
      "const": false
    },
    "requires_conduit": {
      "enum": [
        "none",
        "hammer"
      ]
    },
    "allows_hammer_symbol": {
      "type": "boolean"
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource",
        "amount"
      ],
      "properties": {
        "resource": {
          "enum": [
            "resource.willpower",
            "resource.piety",
            "resource.health"
          ]
        },
        "amount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        }
      }
    },
    "effect_summary": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "enum": [
        "grant",
        "revoke"
      ]
    },
    "target_id": {
      "$ref": "common.schema.json#/$defs/content_id"
    },
    "grant_flag": {
      "$ref": "common.schema.json#/$defs/content_id"
    },
    "confidence": {
      "$ref": "common.schema.json#/$defs/confidence_label"
    },
    "canon_status": {
      "$ref": "common.schema.json#/$defs/canon_status"
    },
    "approval": {
      "$ref": "common.schema.json#/$defs/review_record"
    },
    "source_notes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/source_note"
      }
    }
  }
}
