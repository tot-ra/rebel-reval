{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "magic.schema.json",
  "title": "Reval Rebel authored dual-school magic content",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "id",
    "name",
    "confidence",
    "canon_status",
    "approval",
    "resolution",
    "runtime_combination_allowed",
    "source_notes"
  ],
  "properties": {
    "type": {
      "enum": [
        "spell",
        "rite",
        "magic_grant"
      ]
    },
    "id": {
      "$ref": "common.schema.json#/$defs/content_id"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "school": {
      "enum": [
        "school.pagan",
        "school.divine"
      ]
    },
    "sequence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "string",
        "pattern": "^element\\.[a-z][a-z0-9_]*$"
      }
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^element\\.[a-z][a-z0-9_]*$"
      }
    },
    "resolution": {
      "const": "authored_lookup"
    },
    "fixed_liturgy": {
      "const": true
    },
    "runtime_combination_allowed": {
      "const": false
    },
    "requires_conduit": {
      "enum": [
        "none",
        "hammer"
      ]
    },
    "allows_hammer_symbol": {
      "type": "boolean"
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource",
        "amount"
      ],
      "properties": {
        "resource": {
          "enum": [
            "resource.willpower",
            "resource.piety",
            "resource.health"
          ]
        },
        "amount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        }
      }
    },
    "effect_summary": {
      "type": "string",
      "minLength": 1
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "delivery"
      ],
      "properties": {
        "delivery": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "projectile",
                "area_pulse",
                "summon"
              ]
            },
            "speed": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "range": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "radius": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "summon_kind": {
              "const": "illusionary_double"
            },
            "lifetime_sec": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "health": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "collision_radius": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "aggro_radius": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "spawn_offset": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "impact": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "damage",
                "stagger"
              ]
            },
            "amount": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "damage_type": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "duration_sec": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "area": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "radius",
            "effect"
          ],
          "properties": {
            "radius": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "effect": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "amount",
                "damage_type"
              ],
              "properties": {
                "kind": {
                  "const": "damage"
                },
                "amount": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "damage_type": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                }
              }
            }
          }
        }
      }
    },
    "operation": {
      "enum": [
        "grant",
        "revoke"
      ]
    },
    "target_id": {
      "$ref": "common.schema.json#/$defs/content_id"
    },
    "grant_flag": {
      "$ref": "common.schema.json#/$defs/content_id"
    },
    "confidence": {
      "$ref": "common.schema.json#/$defs/confidence_label"
    },
    "canon_status": {
      "$ref": "common.schema.json#/$defs/canon_status"
    },
    "approval": {
      "$ref": "common.schema.json#/$defs/review_record"
    },
    "source_notes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/source_note"
      }
    }
  }
}
